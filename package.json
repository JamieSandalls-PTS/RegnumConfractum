{
  "name": "regnum-confractum",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Regnum Confractum — persistent-world roleplaying MMO. See CLAUDE.md and docs/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts client",
    "build:client": "vite build --config client/vite.config.ts client",
    "build:characters": "tsx tools/src/build-characters.ts",
    "build:environment": "tsx tools/src/build-environment.ts",
    "rebuild:walls": "python tools/src/walls-to-assets.py",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx tools/src/validate-content.ts",
    "bots": "tsx sim/src/run-bots.ts",
    "dev:tools": "tsx tools/src/studio-server.ts",
    "dev:editor": "npm run dev:tools",
    "dev:studio": "npm run dev:tools",
    "play": "tsx tools/src/control.ts",
    "name:assets": "tsx tools/src/name-assets.ts",
    "draft:animations": "tsx tools/src/draft-animation-sets.ts",
    "measure:weapons": "tsx tools/src/measure-weapons.ts",
    "fit:weapons": "tsx tools/src/fit-weapons.ts",
    "measure:hand": "tsx tools/src/measure-hand.ts",
    "name:parts": "tsx tools/src/name-parts.ts",
    "name:environment": "tsx tools/src/name-environment.ts",
    "map:generate": "python tools/src/build-round-map.py",
    "map:tavern": "python tools/src/build-tavern.py",
    "map:walls": "python tools/src/walls-to-assets.py",
    "map:paint": "python tools/src/paint-areas.py",
    "map:dress": "python tools/src/dress-areas.py",
    "map:dress-town": "python tools/src/dress-ashfold.py",
    "map:prune": "tsx tools/src/prune-unreachable.ts",
    "map:rebake": "tsx tools/src/rebake-masks.ts",
    "map:why": "tsx tools/src/why-unreachable.ts",
    "build:audio": "python tools/src/build-audio.py",
    "build:ground": "python tools/src/build-ground-textures.py",
    "ingest:ground": "python tools/src/ingest-ground-textures.py"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "three": "^0.185.1",
    "wasmoon": "^1.16.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  }
}
