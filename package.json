{
  "name": "regnum-confractum",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Regnum Confractum — persistent-world roleplaying MMO. See CLAUDE.md and docs/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:server": "tsx server/src/index.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx server/src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "tsx tools/src/validate-content.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "ws": "^8.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^2.1.0"
  }
}
