# Copy to .env (git-ignored) and adjust. The server also reads real env vars.

# Postgres. `npm run db:up` starts one on host port 5433 (5433 to avoid
# colliding with any locally installed Postgres on 5432).
DATABASE_URL=postgres://rc:rc@localhost:5433/regnum

# Game WebSocket port.
PORT=8080

# Admin inspection UI port (D-114). Binds localhost by default.
ADMIN_PORT=8081

# If set, the admin UI requires this token (?token=... or X-Admin-Token header).
# Leave unset for local development only.
#ADMIN_TOKEN=change-me

# --- The Round (D-521, D-607) -----------------------------------------------
# Round mode is ON unless this is 0. The Round is the shipping target, so a
# server that boots the persistent world boots the mode that is not being
# shipped — and the only way to find that out is to log in and notice that
# nothing ever starts.
#ROUND_MODE=0

# Where players begin. Follows ROUND_MODE unless set: 'round-town' in a round,
# 'hanged-ferryman' in the persistent world. Setting it here overrides both,
# which is a good way to put the cast somewhere the round does not reach.
#DEFAULT_AREA_ID=round-town

# Whether the lobby may summon bots to make up the cast (D-540, D-607). On
# outside production. ⚠ It registers accounts and creates characters on demand,
# so it must be 0 on anything public.
#ALLOW_BOTS=0

# Smallest cast a round will start with. Drop to 1 to walk a round alone.
#ROUND_MIN_CAST=3
