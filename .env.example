# Copy to .env (git-ignored) and adjust. The server also reads real env vars.

# Postgres. `npm run db:up` starts one on host port 5433 (5433 to avoid
# colliding with any locally installed Postgres on 5432).
DATABASE_URL=postgres://rc:rc@localhost:5433/regnum

# Game WebSocket port.
PORT=8080

# Admin inspection UI port (D-114). Binds localhost by default.
ADMIN_PORT=8081

# If set, the admin UI requires this token (?token=... or X-Admin-Token header).
# Leave unset for local development only.
#ADMIN_TOKEN=change-me
